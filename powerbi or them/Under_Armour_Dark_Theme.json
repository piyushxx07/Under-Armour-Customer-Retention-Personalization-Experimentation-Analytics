{
  "name": "Under Armour Dark Analytics Theme",
  "dataColors": [
    "#E31C23",
    "#A51217",
    "#F59E0B",
    "#22C55E",
    "#667085",
    "#8A93A0",
    "#C7CDD6",
    "#F5F7FA"
  ],
  "background": "#0B0D12",
  "foreground": "#F5F7FA",
  "tableAccent": "#E31C23",
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#1A2029"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#2A313C"
              }
            },
            "radius": 12
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#F5F7FA"
              }
            },
            "fontSize": 14,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ],
        "legend": [
          {
            "labelColor": {
              "solid": {
                "color": "#C7CDD6"
              }
            },
            "fontSize": 10
          }
        ],
        "categoryAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#C7CDD6"
              }
            },
            "titleColor": {
              "solid": {
                "color": "#C7CDD6"
              }
            },
            "gridlineColor": {
              "solid": {
                "color": "#2A313C"
              }
            },
            "fontSize": 10
          }
        ],
        "valueAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#C7CDD6"
              }
            },
            "titleColor": {
              "solid": {
                "color": "#C7CDD6"
              }
            },
            "gridlineColor": {
              "solid": {
                "color": "#2A313C"
              }
            },
            "fontSize": 10
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#F5F7FA"
              }
            },
            "fontSize": 10
          }
        ]
      }
    },
    "card": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#1A2029"
              }
            },
            "transparency": 0
          }
        ],
        "categoryLabels": [
          {
            "color": {
              "solid": {
                "color": "#C7CDD6"
              }
            },
            "fontSize": 11
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#F5F7FA"
              }
            },
            "fontSize": 26
          }
        ]
      }
    }
  }
}